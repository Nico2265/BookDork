# ── Secretos y configuración sensible ──────────────────────────────────────────
.env
.env.*
!.env.example

# ── Credenciales Firebase ──────────────────────────────────────────────────────
*.json
!package.json
*.firebase/
firebase-debug.log

# ── Certificados TLS ──────────────────────────────────────────────────────────
certs/
*.key
*.crt
*.pem
*.p12
*.pfx

# ── Caché de conversiones (documentos de usuarios) ────────────────────────────
conversion_cache/

# ── Bases de datos ────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/
.pytest_cache/
htmlcov/
.coverage
*.cover
.mypy_cache/
.ruff_cache/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── IDEs ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Sistema operativo ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Archivos temporales ───────────────────────────────────────────────────────
tmp/
temp/
*.tmp

# ── Binarios y archivos grandes ───────────────────────────────────────────────
*.exe
*.msix
*.zip
data.ms/

# ── Archivos movidos fuera del frontend público ───────────────────────────────
# (zips de backup, Dockerfile/requirements/docker-compose duplicados que antes
# se exponían vía /static; ver project_static_exposure_fix.md)
archive/

# ── Build output (generado por build_assets.py) ───────────────────────────────
Frontend/dist/

# ── Runtime ───────────────────────────────────────────────────────────────────
# Lockfile efímero para asignación de slots HTTP en modo multi-worker.
# Cada arranque limpia el suyo; entradas viejas se purgan a la hora.
.bookdork_http_slots
loadtest/results_*.json
loadtest/prod_server.log

# ── Fixtures de tests con copyright (libros reales — NO versionar) ──────────────
# Conversiones de libros de texto con derechos de autor (Serway, Zill) usadas como
# fixtures locales. Quien clone el repo debe aportar sus propios archivos.
# Los scripts de conversión/análisis (.py) sí se versionan; solo se excluye el contenido.
tests/serway_out/
tests/stem_fixtures/zill_full.md
tests/stem_fixtures/zill_ch1_recovery.md
tests/stem_fixtures/zill_ch1_enhanced.md
tests/stem_fixtures/zill_recovery_report.json
# PDF escaneado de origen incierto usado en loadtest de OCR.
loadtest/sample_scanned.pdf
