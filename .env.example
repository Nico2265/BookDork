# =============================================================================
# .env.example — Plantilla de configuración de BookDork (SIN secretos)
# =============================================================================
# Copia este archivo a `.env` y rellena los valores reales:
#     cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# NUNCA subas el `.env` real al repositorio ni a la nube (OneDrive/Drive).
# El `.gitignore` ya ignora `.env`, `certs/`, `*.key`, `*.crt`.
#
# Generar claves fuertes:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"   # MEILI_MASTER_KEY
#     python -c "import secrets; print(secrets.token_urlsafe(32))"   # ADMIN_API_KEY
# =============================================================================

# ── Meilisearch ───────────────────────────────────────────────────────────────
MEILI_HOST=http://localhost:7700

# Master key del servidor Meilisearch. Debe coincidir con la variable de entorno
# MEILI_MASTER_KEY del contenedor. start.py recrea el contenedor si no coincide.
MEILI_MASTER_KEY=changeme_strong_master_key

# Clave de SOLO búsqueda (least privilege). Crearla en Meilisearch con la master
# key una vez que el contenedor esté arriba:
#   POST http://localhost:7700/keys
#   Authorization: Bearer <MEILI_MASTER_KEY>
#   {"name":"BookDork Search Key","actions":["search"],"indexes":["books"],"expiresAt":null}
# El valor devuelto en el campo "key" va aquí. Si se deja vacío, el backend cae
# a la master key (funcional pero menos seguro). OJO: el valor se deriva de la
# master key — al rotar la master key hay que recrear esta search key.
MEILI_SEARCH_API_KEY=

# ── Seguridad de la API ───────────────────────────────────────────────────────
# Protege los endpoints admin (/api/admin/*). Se envía en el header X-Admin-API-Key.
# RBAC: esta clave equivale al rol 'superadmin' (compatibilidad heredada). Además
# de la clave, /api/admin/* acepta un Firebase ID token con custom claim 'role'
# (user/support/billing/superadmin). Bootstrap del primer admin y matriz de roles:
# ver DEPLOY_SECURITY.md §5.
ADMIN_API_KEY=changeme_admin_api_key

# ── Aplicación ────────────────────────────────────────────────────────────────
DEBUG=false                 # NUNCA true en producción (desactiva validación de claves)
HTTP3_PORT=8000
FORCE_HTTP=true             # true = HTTP plano (dev/ngrok); false = HTTPS + HTTP/3 (requiere certs)

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Ruta al JSON de la cuenta de servicio. Si se deja vacío, los endpoints
# /api/admin/* responden 503 hasta configurarlo.
FIREBASE_SERVICE_ACCOUNT_PATH=
